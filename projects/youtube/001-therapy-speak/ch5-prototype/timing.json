  "archive_sha256": "adb8faa6183d357eba5a2699486d7d914faaf68377d511af79a84ee2f29af639",
  "sentences": [
    {
      "index": 137,
      "chapter": 5,
      "paragraph": 110,
      "text": "Therapy-speak doesn't only influence how we judge other people.",
      "start": 640.546,
      "end": 643.948,
      "all_words_matched": true,
      "boundary_verified": true,
      "missing_words": [],
      "matched_words": 9,
      "total_words": 9
    },
    {
      "index": 138,
      "chapter": 5,
      "paragraph": 110,
      "text": "It can also shape the explanations we accept for our own problems.",
      "start": 644.449,
      "end": 647.871,
      "all_words_matched": true,
      "boundary_verified": true,
      "missing_words": [],
      "matched_words": 12,
      "total_words": 12
    },
    {
      "index": 139,
      "chapter": 5,
      "paragraph": 111,
      "text": "Consider a worker who regularly puts in sixty hours a week, answers messages on weekends, and struggles to get time off.",
      "start": 648.56,
      "end": 655.506,
      "all_words_matched": false,
      "boundary_verified": true,
      "missing_words": [
        "sixty"
      ],
      "matched_words": 20,
      "total_words": 21
    },
    {
      "index": 140,
      "chapter": 5,
      "paragraph": 112,
      "text": "She says she's burned out.",
      "start": 656.107,
      "end": 657.288,
      "all_words_matched": true,
      "boundary_verified": true,
      "missing_words": [],
      "matched_words": 5,
      "total_words": 5
    },
    {
      "index": 141,
      "chapter": 5,
      "paragraph": 113,
      "text": "Her friends suggest setting boundaries, protecting her energy, and making more time for herself.",
      "start": 657.688,
      "end": 663.233,
      "all_words_matched": true,
      "boundary_verified": true,
      "missing_words": [],
      "matched_words": 14,
      "total_words": 14
    },
    {
      "index": 142,
      "chapter": 5,
      "paragraph": 114,
      "text": "Those suggestions may help.",
      "start": 663.934,
      "end": 665.375,
      "all_words_matched": true,
      "boundary_verified": true,
      "missing_words": [],
      "matched_words": 4,
      "total_words": 4
    },
    {
      "index": 143,
      "chapter": 5,
      "paragraph": 115,
      "text": "But suppose the employer expects everyone to maintain the same schedule.",
      "start": 665.783,
      "end": 669.425,
      "all_words_matched": true,
      "boundary_verified": true,
      "missing_words": [],
      "matched_words": 11,
      "total_words": 11
    },
    {
      "index": 144,
      "chapter": 5,
      "paragraph": 116,
      "text": "What happens when a problem partly created by an organization is addressed mainly through personal behavior?",
      "start": 669.845,
      "end": 675.148,
      "all_words_matched": true,
      "boundary_verified": true,
      "missing_words": [],
      "matched_words": 16,
      "total_words": 16
    },
    {
      "index": 145,
      "chapter": 5,
      "paragraph": 117,
      "text": "Burnout is a particularly revealing example.",
      "start": 675.768,
      "end": 678.53,
      "all_words_matched": true,
      "boundary_verified": true,
      "missing_words": [],
      "matched_words": 6,
      "total_words": 6
    },
    {
      "index": 146,
      "chapter": 5,
      "paragraph": 118,
      "text": "The World Health Organization classifies it as an occupational phenomenon connected to chronic workplace stress that hasn't been successfully managed.",
      "start": 678.91,
      "end": 687.074,
      "all_words_matched": true,
      "boundary_verified": true,
      "missing_words": [],
      "matched_words": 20,
      "total_words": 20
    },
    {
      "index": 147,
      "chapter": 5,
      "paragraph": 119,
      "text": "The WHO doesn't classify burnout itself as a medical condition.",
      "start": 687.354,
      "end": 691.256,
      "all_words_matched": true,
      "boundary_verified": true,
      "missing_words": [],
      "matched_words": 10,
      "total_words": 10
    },
    {
      "index": 148,
      "chapter": 5,
      "paragraph": 120,
      "text": "And its definition explicitly connects the experience to work.",
      "start": 691.636,
      "end": 695.078,
      "all_words_matched": true,
      "boundary_verified": true,
      "missing_words": [],
      "matched_words": 9,
      "total_words": 9
    },
    {
      "index": 149,
      "chapter": 5,
      "paragraph": 121,
      "text": "Yet popular advice can place much of the responsibility on the employee.",
      "start": 695.375,
      "end": 699.418,
      "all_words_matched": true,
      "boundary_verified": true,
      "missing_words": [],
      "matched_words": 12,
      "total_words": 12
    },
    {
      "index": 150,
      "chapter": 5,
      "paragraph": 122,
      "text": "Learn to say no.",
      "start": 699.618,
      "end": 700.499,
      "all_words_matched": true,
      "boundary_verified": true,
      "missing_words": [],
      "matched_words": 4,
      "total_words": 4
    },
    {
      "index": 151,
      "chapter": 5,
      "paragraph": 122,
      "text": "Take more breaks.",
      "start": 701.14,
      "end": 701.86,
      "all_words_matched": true,
      "boundary_verified": true,
      "missing_words": [],
      "matched_words": 3,
      "total_words": 3
    },
    {
      "index": 152,
      "chapter": 5,
      "paragraph": 122,
      "text": "Develop a healthier routine.",
      "start": 702.18,
      "end": 703.481,
      "all_words_matched": true,
      "boundary_verified": true,
      "missing_words": [],
      "matched_words": 4,
      "total_words": 4
    },
    {
      "index": 153,
      "chapter": 5,
      "paragraph": 123,
      "text": "There may be good reasons to do those things.",
      "start": 703.802,
      "end": 705.923,
      "all_words_matched": true,
      "boundary_verified": true,
      "missing_words": [],
      "matched_words": 9,
      "total_words": 9
    },
    {
      "index": 154,
      "chapter": 5,
      "paragraph": 124,
      "text": "But none of them necessarily changes understaffing, unreasonable deadlines, or a workplace culture that expects people to be constantly available.",
      "start": 706.344,
      "end": 715.111,
      "all_words_matched": false,
      "boundary_verified": true,
      "missing_words": [
        "understaffing,"
      ],
      "matched_words": 19,
      "total_words": 20
    },
    {
      "index": 155,
      "chapter": 5,
      "paragraph": 125,
      "text": "An individual can make better choices while still facing conditions that remain fundamentally unreasonable.",
      "start": 715.591,
      "end": 721.556,
      "all_words_matched": true,
      "boundary_verified": true,
      "missing_words": [],
      "matched_words": 14,
      "total_words": 14
    }
  ],
