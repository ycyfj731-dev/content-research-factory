{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-research-factory.local/schemas/consensus_observation.schema.json",
  "title": "ConsensusObservation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "asset_id",
    "captured_at",
    "published_at",
    "platform",
    "source_group",
    "content_type",
    "raw_text",
    "direction",
    "horizon",
    "classifier_confidence",
    "conviction",
    "position_disclosed",
    "uniqueness_factor",
    "source_weight",
    "raw_hash",
    "provenance"
  ],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "asset_id": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "published_at": {"type": "string", "format": "date-time"},
    "platform": {"type": "string", "minLength": 1},
    "source_group": {
      "type": "string",
      "enum": ["institution", "kol", "crowd"]
    },
    "source_id": {"type": ["string", "null"]},
    "author_id_hash": {"type": ["string", "null"]},
    "author_display_name": {"type": ["string", "null"]},
    "content_type": {
      "type": "string",
      "enum": ["report", "post", "video", "comment", "reply", "other"]
    },
    "parent_source_id": {"type": ["string", "null"]},
    "source_url": {"type": ["string", "null"]},
    "raw_text": {"type": "string"},
    "direction": {
      "type": "integer",
      "minimum": -2,
      "maximum": 2
    },
    "horizon": {
      "type": "string",
      "enum": ["intraday", "1_5d", "6_20d", "21_60d", "longer", "unspecified"]
    },
    "classifier_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "conviction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "position_disclosed": {"type": "boolean"},
    "disclosed_position": {
      "type": ["string", "null"],
      "enum": ["long", "short", "flat", "unknown", null]
    },
    "reason_tags": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "target_price": {"type": ["number", "null"]},
    "narrative_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "uniqueness_factor": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_weight": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "raw_hash": {"type": "string", "minLength": 1},
    "engagement": {
      "type": "object",
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "model_version"],
      "properties": {
        "tool": {"type": "string"},
        "model_version": {"type": "string"},
        "retrieval_run_id": {"type": ["string", "null"]},
        "classification_run_id": {"type": ["string", "null"]}
      }
    }
  }
}
